node_modules/
*.log

# Saída de build. O .plugin.js é a exceção: o auto-update busca ele por raw,
# então precisa estar versionado. O instalador (2 MB) vai para Releases.
release/*
!release/P2PShare.plugin.js
# Só o número da versão: a checagem frequente do auto-update lê este.
!release/VERSION
# Assinatura do plugin: o auto-update baixa junto e confere antes de gravar.
!release/P2PShare.plugin.js.sig

# Chave privada de assinatura: fica fora do repo, isto é só uma rede de proteção.
*.pem

# Artefatos do Rust
native/audio-helper/target/
